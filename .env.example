# Variables de entorno para Tourist Guides App

# Base de datos MongoDB (DataMart)
MONGODB_URI=mongodb://localhost:27017/tourist_guides_datamart

# Base de datos PostgreSQL (Transaccional)
POSTGRES_URL=postgresql://username:password@localhost:5432/tourist_guides_db

# JWT para autenticación
JWT_SECRET=your_super_secure_jwt_secret_key_here_change_in_production

# OpenWeatherMap API Key (Gratuita)
# Registrarse en: https://openweathermap.org/api
# Límite gratuito: 1000 llamadas por día
NEXT_PUBLIC_OPENWEATHER_API_KEY=tu_api_key_aqui

# API de clima (OpenWeatherMap)
WEATHER_API_KEY=your_openweather_api_key_here

# Google Maps API (para geolocalización)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Configuración de Next.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Configuración de correo (SendGrid, Nodemailer, etc.)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_email@gmail.com
EMAIL_SERVER_PASSWORD=your_email_password

# Configuración de almacenamiento (AWS S3, Cloudinary, etc.)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Configuración de pagos (Stripe, PayPal, etc.)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Redis para cache (opcional)
REDIS_URL=redis://localhost:6379

# Configuración de desarrollo
NODE_ENV=development
PORT=3000

# Docker compose variables
COMPOSE_PROJECT_NAME=tourist_guides_app
