{
  "name": "tourist-guides-app",
  "version": "1.0.0",
  "description": "Aplicación móvil multiplataforma para guías turísticos con arquitectura de microservicios",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "api:dev": "npx tsx watch src/api/server.ts",
    "api:full": "npx tsx watch src/api/server.ts",
    "api:build": "tsc --project tsconfig.json",
    "api:start": "node dist/api/server.js",
    "dev:full": "concurrently \"npm run dev\" \"npm run api:dev\"",
    "docker:build": "docker build -t tourist-guides-app .",
  "docker:run": "docker run -p 3000:3000 tourist-guides-app",
  "restart:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/restart-backend.ps1"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.6",
    "@hookform/resolvers": "^5.1.1",
