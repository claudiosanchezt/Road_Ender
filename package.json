    "@types/multer": "^2.0.0",
    "@types/pg": "^8.10.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "axios": "^1.10.0",
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "framer-motion": "^12.23.9",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.525.0",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "next": "^14.0.0",
    "pg": "^8.11.0",
    "react": "^18.0.0",
    "react-bootstrap": "^2.9.0",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^18.0.0",
    "react-hook-form": "^7.61.1",
