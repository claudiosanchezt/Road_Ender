{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Desarrollo - Ejecutar aplicación",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev"
			],
			"group": "build",
			"isBackground": true,
			"problemMatcher": [
				"$tsc",
				"$eslint-stylish"
			]
		},
		{
			"label": "Instalar dependencias",
			"type": "shell",
			"command": "npm",
			"args": [
				"install"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Construir proyecto",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"group": "build",
			"problemMatcher": [
				"$tsc"
			]
		},
		{
			"label": "Mobile App - Expo Web",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"web"
			],
			"options": {
				"cwd": "${workspaceFolder}/mobile-app"
			},
			"group": "build",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "API Server - Desarrollo",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"api:dev"
			],
			"group": "build",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Full Stack - Desarrollo",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev:full"
			],
			"group": "build",
			"isBackground": true,
			"problemMatcher": []
		}
	]
}